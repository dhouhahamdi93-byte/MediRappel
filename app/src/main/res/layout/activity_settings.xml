<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layoutDirection="locale"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:text="@string/settings_title"
            style="@style/Medi.Title" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_language_section"
            style="@style/Medi.Section" />

        <RadioGroup
            android:id="@+id/rgLanguage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <RadioButton
                android:id="@+id/rbSystem"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/settings_language_system" />

            <RadioButton
                android:id="@+id/rbFr"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/settings_language_fr" />

            <RadioButton
                android:id="@+id/rbAr"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/settings_language_ar" />
        </RadioGroup>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/settings_notifications_section"
            style="@style/Medi.Section" />

        <TextView
            android:id="@+id/tvPermissionState"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/Medi.Subtitle" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_notification_hint"
            style="@style/Medi.Subtitle" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPermission"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/settings_notification_permission" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/settings_account_section"
            style="@style/Medi.Section" />

        <TextView
            android:id="@+id/tvEmail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/Medi.Subtitle" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnLogout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/settings_logout" />
    </LinearLayout>
</ScrollView>
