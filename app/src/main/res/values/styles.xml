<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.MediRappel" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
        <item name="android:windowBackground">@color/colorBackground</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:fontFamily">sans</item>
    </style>

    <!-- Style parent explicite : les noms avec point héritent implicitement de "Medi". -->
    <style name="Medi" />

    <style name="Medi.Title">
        <item name="android:textSize">26sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/colorPrimaryDark</item>
    </style>

    <style name="Medi.Subtitle">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/colorMutedText</item>
    </style>

    <style name="Medi.Section">
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/colorPrimary</item>
        <item name="android:paddingTop">8dp</item>
    </style>
</resources>
